;;; --- shared helpers ---

(defun t-bv (string)
  "ASCII STRING as a byte vector."
  (map '(simple-array (unsigned-byte 8) (*)) #'char-code string))

(defun t-hex (bytes)
  (with-output-to-string (s)
    (loop for b across bytes do (format s "~(~2,'0x~)" b))))

(defun t-u16 (bytes pos) (logior (aref bytes pos) (ash (aref bytes (1+ pos)) 8)))

(defun t-u32 (bytes pos)
  (logior (aref bytes pos) (ash (aref bytes (1+ pos)) 8)
          (ash (aref bytes (+ pos 2)) 16) (ash (aref bytes (+ pos 3)) 24)))

